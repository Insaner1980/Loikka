; Build the per-user WinUI installer with Build-NativeInstaller.ps1.
Unicode true
!include "MUI2.nsh"
!include "LogicLib.nsh"
!ifndef PUBLISH_DIR
  !error "PUBLISH_DIR must point to the complete self-contained publish directory."
!endif
!ifndef OUTPUT_FILE
  !error "OUTPUT_FILE is required."
!endif
!ifndef UNINSTALL_FILES
  !error "UNINSTALL_FILES is generated by Build-NativeInstaller.ps1."
!endif
!ifndef PRODUCT_VERSION
  !define PRODUCT_VERSION "1.0.0"
!endif
Name "Loikka Native Beta"
OutFile "${OUTPUT_FILE}"
Icon "${PUBLISH_DIR}\Assets\AppIcon.ico"
UninstallIcon "${PUBLISH_DIR}\Assets\AppIcon.ico"
InstallDir "$LOCALAPPDATA\Programs\Loikka.Native.Beta"
RequestExecutionLevel user
SetCompressor /SOLID lzma
VIProductVersion "${PRODUCT_VERSION}.0"
VIAddVersionKey "ProductName" "Loikka Native Beta"
VIAddVersionKey "ProductVersion" "${PRODUCT_VERSION}"
VIAddVersionKey "FileDescription" "Loikka Native Beta installer"
VIAddVersionKey "FileVersion" "${PRODUCT_VERSION}"
VIAddVersionKey "LegalCopyright" "Loikka"
!define MUI_ABORTWARNING
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "Finnish"
!insertmacro MUI_LANGUAGE "English"

Function .onInit
  SetShellVarContext current
  ReadRegStr $0 HKLM "Software\Microsoft\Windows NT\CurrentVersion" "CurrentBuildNumber"
  IntCmp $0 22000 supported_windows unsupported_windows supported_windows
unsupported_windows:
  MessageBox MB_OK|MB_ICONSTOP "Loikka Native Beta requires Windows 11. / Loikka Native Beta tarvitsee Windows 11:n."
  Abort
supported_windows:
  StrCmp $INSTDIR "$LOCALAPPDATA\Programs\Loikka.Native.Beta" +3
    MessageBox MB_OK|MB_ICONSTOP "Beta installs only to the separate Loikka.Native.Beta program directory."
    Abort
FunctionEnd

Section "Loikka Native Beta" MainSection
  SetShellVarContext current
  SetOutPath "$INSTDIR"
  File /r "${PUBLISH_DIR}\*"
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  CreateDirectory "$SMPROGRAMS\Loikka Native Beta"
  CreateShortcut "$SMPROGRAMS\Loikka Native Beta\Loikka Native Beta.lnk" "$INSTDIR\Loikka.App.exe" '--data-root "$LOCALAPPDATA\Loikka.Native.Beta"'
  CreateShortcut "$SMPROGRAMS\Loikka Native Beta\Poista Loikka Native Beta.lnk" "$INSTDIR\Uninstall.exe"
  WriteRegStr HKCU "Software\Loikka.Native.Beta" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Loikka.Native.Beta" "DisplayName" "Loikka Native Beta"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Loikka.Native.Beta" "DisplayVersion" "${PRODUCT_VERSION}"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Loikka.Native.Beta" "Publisher" "Loikka"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Loikka.Native.Beta" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Loikka.Native.Beta" "InstallLocation" "$INSTDIR"
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Loikka.Native.Beta" "NoModify" 1
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Loikka.Native.Beta" "NoRepair" 1
SectionEnd

Section "Uninstall"
  SetShellVarContext current
  !include "${UNINSTALL_FILES}"
  Delete "$INSTDIR\Uninstall.exe"
  RMDir "$INSTDIR"
  Delete "$SMPROGRAMS\Loikka Native Beta\Loikka Native Beta.lnk"
  Delete "$SMPROGRAMS\Loikka Native Beta\Poista Loikka Native Beta.lnk"
  RMDir "$SMPROGRAMS\Loikka Native Beta"
  DeleteRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Loikka.Native.Beta"
  DeleteRegKey HKCU "Software\Loikka.Native.Beta"
  ; Deliberately retain every data root, media library, backup, and legacy installation.
SectionEnd
