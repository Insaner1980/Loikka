<Application x:Class="Loikka_App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
   <DataTemplate x:Key="RowTemplate">
    <StackPanel Spacing="4" Padding="8"><TextBlock Text="{Binding Title}" FontSize="18" TextWrapping="Wrap"/><TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   </DataTemplate>
   <DataTemplate x:Key="PhotoTemplate">
    <StackPanel Spacing="8" Padding="8"><Image Source="{Binding Image}" Height="180" Stretch="Uniform"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap"/></StackPanel>
   </DataTemplate>
   <DataTemplate x:Key="AthleteTemplate">
    <Grid Padding="8" ColumnSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <PersonPicture Width="56" Height="56" DisplayName="{Binding Title}" ProfilePicture="{Binding Image}"/>
     <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Title}" FontSize="18" TextWrapping="Wrap"/><TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    </Grid>
   </DataTemplate>
  </ResourceDictionary>
 </Application.Resources>
</Application>
